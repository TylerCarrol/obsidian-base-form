filters:
  and:
    - note.baseform == true
formulas:
  Link: link(file, file)
  Test: '"Test: " + score + " - " + interests'
  show-appointment: featured
  show-full-name: "false"
properties:
  note.full-name:
    displayName: Full name
  note.interests:
    displayName: Interests
  note.reference:
    displayName: Reference
  note.related-notes:
    displayName: Related notes
  note.score:
    displayName: Score
  note.featured:
    displayName: Featured
  note.review-date:
    displayName: Review date
  note.appointment:
    displayName: Appointment
views:
  - type: base-form
    name: Form
    order:
      - full-name
      - interests
      - reference
      - related-notes
      - score
      - featured
      - review-date
      - appointment
    itemSpacing: 8
    formWidth: 80
    showOnlyEmptyInputs: false
  - type: base-form
    name: Empty Properties Only
    groupBy:
      property: featured
      direction: ASC
    order:
      - full-name
      - interests
      - reference
      - related-notes
      - score
      - featured
      - review-date
      - appointment
      - non-existing-property
    itemSpacing: 8
    formWidth: 80
    showOnlyEmptyInputs: true
    hideNonEmptyProperties: true
    manualSubmit: true
    submitButtonName: Submit
    submitButtonPosition: bottom-each-note
  - type: base-form
    name: Existing Properties Only
    groupBy:
      property: reference
      direction: ASC
    order:
      - formula.Test
      - full-name
      - interests
      - reference
      - related-notes
      - score
      - featured
      - review-date
      - appointment
      - non-existing-property
    itemSpacing: 8
    formWidth: 80
    showOnlyEmptyInputs: true
    showOnlyExistingInputs: true
    hideNonEmptyProperties: true
    hideNonExistentProperties: true
    enableDeletePropertyButton: true
    manualSubmit: false
  - type: base-form
    name: Conditional Show/Hide
    groupBy:
      property: featured
      direction: ASC
    order:
      - full-name
      - interests
      - reference
      - related-notes
      - score
      - featured
      - review-date
      - appointment
      - non-existing-property
      - show-interests
    visibilityConditionalPrefix: show-
    visibilityConditionalMode: show
    itemSpacing: 8
    formWidth: 80
    showOnlyEmptyInputs: true
    hideNonEmptyProperties: false
    manualSubmit: false
    submitButtonName: Submit
    submitButtonPosition: bottom-each-note
  - type: base-form
    name: This - Form
    filters:
      and:
        - file == this.file
    order:
      - full-name
      - interests
      - reference
      - related-notes
      - score
      - formula.Test
      - featured
      - review-date
      - appointment
    showFileName: false
    itemSpacing: 3
    formWidth: 80
  - type: cards
    name: Cards
    groupBy:
      property: featured
      direction: ASC
    order:
      - full-name
      - interests
      - reference
      - related-notes
      - score
      - featured
      - review-date
      - appointment
      - formula.Link
    itemSpacing: 8
    formWidth: 80
    showOnlyEmptyInputs: true
  - type: table
    name: Table
    order:
      - file.name
      - full-name
      - interests
      - score
      - featured
      - review-date
      - appointment
