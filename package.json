		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.0.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
